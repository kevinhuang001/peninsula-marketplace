{
  "schema": "peninsula.datasource/v1",
  "id": "github-repository-stars",
  "name": "GitHub 仓库 Star 数",
  "description": "显示公开仓库的 Star 总数。",
  "icon": {
    "mime": "image/svg+xml",
    "base64": ""
  },
  "inputs": {
    "owner": {
      "type": "string",
      "label": "仓库所有者",
      "default": "kevinhuang001",
      "required": true
    },
    "repo": {
      "type": "string",
      "label": "仓库名",
      "default": "peninsula",
      "required": true
    }
  },
  "request": {
    "method": "GET",
    "url": "https://api.github.com/repos/${input.owner}/${input.repo}",
    "headers": {
      "Accept": "application/vnd.github+json",
      "User-Agent": "Peninsula-Marketplace",
      "X-GitHub-Api-Version": "2022-11-28"
    },
    "query": {},
    "timeout_ms": 10000
  },
  "value": {
    "path": "$.stargazers_count",
    "type": "number",
    "multiply": 1,
    "divide": 1,
    "offset": 0,
    "decimals": 0,
    "separator": true,
    "prefix": "",
    "suffix": " 个"
  }
}
