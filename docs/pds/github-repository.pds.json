{
  "schema": "peninsula.datasource/v2",
  "id": "github-repository",
  "name": "GitHub 仓库",
  "name_template": "${input.repo}",
  "description": "一次读取仓库的开放 PR、开放 Issue 和 Star 数。PR 与 Issue 按开放数量净增长提醒。",
  "icon": {
    "mime": "image/svg+xml",
    "base64": ""
  },
  "inputs": {
    "owner": {
      "type": "string",
      "label": "仓库所有者",
      "default": "kevinhuang001",
      "required": true
    },
    "repo": {
      "type": "string",
      "label": "仓库名",
      "default": "peninsula",
      "required": true
    },
    "api_key": {
      "type": "string",
      "label": "GitHub Token",
      "required": true
    }
  },
  "request": {
    "method": "POST",
    "url": "https://api.github.com/graphql",
    "headers": {
      "Authorization": "Bearer ${input.api_key}",
      "Accept": "application/vnd.github+json",
      "User-Agent": "Peninsula-Marketplace"
    },
    "body": {
      "query": "query($owner:String!, $repo:String!){repository(owner:$owner,name:$repo){pullRequests(states:OPEN){totalCount} issues(states:OPEN){totalCount} stargazerCount}}",
      "variables": {
        "owner": "${input.owner}",
        "repo": "${input.repo}"
      }
    },
    "timeout_ms": 10000
  },
  "values": {
    "pull_requests": {
      "name": "开放 PR",
      "value": {
        "path": "$.data.repository.pullRequests.totalCount",
        "type": "number",
        "decimals": 0,
        "separator": true,
        "suffix": " 个"
      },
      "alert": {
        "mode": "change",
        "operator": "gt",
        "threshold": 0,
        "title": "${input.repo} PR 有增加",
        "message": "开放 PR 净增 ${delta} 个，目前 ${value}。"
      }
    },
    "issues": {
      "name": "开放 Issue",
      "value": {
        "path": "$.data.repository.issues.totalCount",
        "type": "number",
        "decimals": 0,
        "separator": true,
        "suffix": " 个"
      },
      "alert": {
        "mode": "change",
        "operator": "gt",
        "threshold": 0,
        "title": "${input.repo} Issue 有增加",
        "message": "开放 Issue 净增 ${delta} 个，目前 ${value}。"
      }
    },
    "stars": {
      "name": "Star 数",
      "value": {
        "path": "$.data.repository.stargazerCount",
        "type": "number",
        "decimals": 0,
        "separator": true,
        "suffix": " 个"
      }
    }
  }
}
