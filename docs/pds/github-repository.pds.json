{
  "schema": "peninsula.datasource/v2",
  "id": "github-repository",
  "name": "GitHub 仓库",
  "name_template": "${input.repo}",
  "description": "一个数据源分别读取开放 PR、开放 Issue 和 Star 数，PR/Issue 净增加时可提醒。",
  "icon": {
    "mime": "image/svg+xml",
    "base64": ""
  },
  "inputs": {
    "owner": {
      "type": "string",
      "label": "仓库所有者",
      "default": "kevinhuang001",
      "required": true
    },
    "repo": {
      "type": "string",
      "label": "仓库名",
      "default": "peninsula",
      "required": true
    }
  },
  "requests": {
    "pull_requests": {
      "method": "GET",
      "url": "https://api.github.com/search/issues",
      "headers": {
        "Accept": "application/vnd.github+json",
        "User-Agent": "Peninsula-Marketplace",
        "X-GitHub-Api-Version": "2022-11-28"
      },
      "query": {
        "q": "repo:${input.owner}/${input.repo} is:pr is:open",
        "per_page": "1"
      },
      "timeout_ms": 10000
    },
    "issues": {
      "method": "GET",
      "url": "https://api.github.com/search/issues",
      "headers": {
        "Accept": "application/vnd.github+json",
        "User-Agent": "Peninsula-Marketplace",
        "X-GitHub-Api-Version": "2022-11-28"
      },
      "query": {
        "q": "repo:${input.owner}/${input.repo} is:issue is:open",
        "per_page": "1"
      },
      "timeout_ms": 10000
    },
    "repository": {
      "method": "GET",
      "url": "https://api.github.com/repos/${input.owner}/${input.repo}",
      "headers": {
        "Accept": "application/vnd.github+json",
        "User-Agent": "Peninsula-Marketplace",
        "X-GitHub-Api-Version": "2022-11-28"
      },
      "timeout_ms": 10000
    }
  },
  "values": {
    "pull_requests": {
      "name": "开放 PR",
      "capsule_text": "PR: ${value}",
    "capsule_layout": "two_line",
      "request": "pull_requests",
      "value": {
        "path": "$.total_count",
        "type": "number",
        "decimals": 0,
        "separator": true,
        "suffix": " 个"
      },
      "alert": {
        "mode": "change",
        "operator": "gt",
        "threshold": 0,
        "title": "${input.repo} PR 增加",
        "message": "开放 PR 净增 ${delta} 个，目前 ${value}。"
      }
    },
    "issues": {
      "name": "开放 Issue",
      "capsule_text": "Issue: ${value}",
    "capsule_layout": "two_line",
      "request": "issues",
      "value": {
        "path": "$.total_count",
        "type": "number",
        "decimals": 0,
        "separator": true,
        "suffix": " 个"
      },
      "alert": {
        "mode": "change",
        "operator": "gt",
        "threshold": 0,
        "title": "${input.repo} Issue 增加",
        "message": "开放 Issue 净增 ${delta} 个，目前 ${value}。"
      }
    },
    "stars": {
      "name": "Star 数",
      "capsule_text": "Star: ${value}",
    "capsule_layout": "two_line",
      "request": "repository",
      "value": {
        "path": "$.stargazers_count",
        "type": "number",
        "decimals": 0,
        "separator": true,
        "suffix": " 个"
      }
    }
  }
}
