{
  "schema": "peninsula.datasource/v1",
  "id": "glm-cn-coding-remaining",
  "name": "GLM · Coding Plan 剩余",
  "description": "中国区 Coding Plan 编程额度的剩余百分比。读取第一个 TOKENS_LIMIT 周期；需使用中国区套餐 Key。",
  "icon": {
    "mime": "image/svg+xml",
    "base64": ""
  },
  "inputs": {
    "api_key": {
      "type": "string",
      "label": "GLM 中国区 Coding Plan Key",
      "description": "填写明文 Key；或先在「秘密」页保存，再填入 $名称$ 引用。",
      "required": true
    },
    "alert_threshold": {
      "type": "number",
      "label": "低额度提醒阈值（%）",
      "description": "当前值低于此阈值时提醒，单位：%。",
      "default": 15,
      "required": true,
      "min": 0
    }
  },
  "request": {
    "method": "GET",
    "url": "https://open.bigmodel.cn/api/monitor/usage/quota/limit",
    "headers": {
      "Authorization": "${input.api_key}",
      "Accept": "application/json"
    },
    "query": {},
    "timeout_ms": 10000
  },
  "value": {
    "path": "$.data.limits[?(@.type=='TOKENS_LIMIT')].percentage",
    "type": "number",
    "multiply": -1,
    "divide": 1,
    "offset": 100,
    "decimals": 0,
    "separator": true,
    "prefix": "",
    "suffix": "%"
  },
  "alert": {
    "operator": "lt",
    "threshold": "${input.alert_threshold}",
    "title": "GLM · Coding Plan 剩余偏低",
    "message": "当前剩余 ${value}，低于设定阈值，请检查额度。"
  }
}
