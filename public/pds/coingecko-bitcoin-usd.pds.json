{
  "schema": "peninsula.datasource/v1",
  "id": "coingecko-bitcoin-usd",
  "name": "Bitcoin · 美元报价",
  "description": "CoinGecko 公共 Simple Price API 返回的比特币美元现价。公共接口可能限流。",
  "icon": {
    "mime": "image/svg+xml",
    "base64": ""
  },
  "inputs": {},
  "request": {
    "method": "GET",
    "url": "https://api.coingecko.com/api/v3/simple/price",
    "headers": {},
    "query": {
      "ids": "bitcoin",
      "vs_currencies": "usd"
    },
    "timeout_ms": 10000
  },
  "value": {
    "path": "$.bitcoin.usd",
    "type": "number",
    "multiply": 1,
    "divide": 1,
    "offset": 0,
    "decimals": 2,
    "separator": false,
    "prefix": "",
    "suffix": " USD"
  }
}
