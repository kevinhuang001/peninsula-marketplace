{
  "schema": "peninsula.datasource/v1",
  "id": "github-open-issues",
  "name": "GitHub 开放 Issue",
  "description": "统计公开仓库当前未关闭的 Issue 数量；超过阈值时提醒。",
  "icon": {
    "mime": "image/svg+xml",
    "base64": ""
  },
  "inputs": {
    "owner": {
      "type": "string",
      "label": "仓库所有者",
      "default": "kevinhuang001",
      "required": true
    },
    "repo": {
      "type": "string",
      "label": "仓库名",
      "default": "peninsula",
      "required": true
    },
    "alert_threshold": {
      "type": "number",
      "label": "提醒阈值（个）",
      "default": 0,
      "required": true,
      "min": 0
    }
  },
  "request": {
    "method": "GET",
    "url": "https://api.github.com/search/issues",
    "headers": {
      "Accept": "application/vnd.github+json",
      "User-Agent": "Peninsula-Marketplace",
      "X-GitHub-Api-Version": "2022-11-28"
    },
    "query": {
      "q": "repo:${input.owner}/${input.repo} is:issue is:open",
      "per_page": "1"
    },
    "timeout_ms": 10000
  },
  "value": {
    "path": "$.total_count",
    "type": "number",
    "multiply": 1,
    "divide": 1,
    "offset": 0,
    "decimals": 0,
    "separator": true,
    "prefix": "",
    "suffix": " 个"
  },
  "alert": {
    "operator": "gt",
    "threshold": "${input.alert_threshold}",
    "title": "GitHub 有未关闭的 Issue",
    "message": "${input.owner}/${input.repo} 当前有 ${value} 个开放的 Issue。"
  }
}
