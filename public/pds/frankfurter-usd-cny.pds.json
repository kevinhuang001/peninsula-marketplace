{
  "schema": "peninsula.datasource/v1",
  "id": "frankfurter-usd-cny",
  "name": "美元兑人民币汇率",
  "description": "Frankfurter 最新 USD/CNY 参考汇率，数据按其公布频率更新。",
  "icon": {
    "mime": "image/svg+xml",
    "base64": ""
  },
  "inputs": {},
  "request": {
    "method": "GET",
    "url": "https://api.frankfurter.dev/v1/latest",
    "headers": {},
    "query": {
      "base": "USD",
      "symbols": "CNY"
    },
    "timeout_ms": 10000
  },
  "value": {
    "path": "$.rates.CNY",
    "type": "number",
    "multiply": 1,
    "divide": 1,
    "offset": 0,
    "decimals": 4,
    "separator": false,
    "prefix": "",
    "suffix": " CNY"
  }
}
