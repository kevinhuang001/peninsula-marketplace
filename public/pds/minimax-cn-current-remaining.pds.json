{
  "schema": "peninsula.datasource/v1",
  "id": "minimax-cn-current-remaining",
  "name": "MiniMax · 当前周期剩余",
  "description": "中国区 Coding Plan 的 general 额度池当前周期剩余百分比。仅支持返回显式 remaining_percent 的套餐响应。",
  "icon": {
    "mime": "image/svg+xml",
    "base64": ""
  },
  "inputs": {
    "api_key": {
      "type": "string",
      "label": "MiniMax 中国区 Coding Plan Key",
      "required": true
    },
    "alert_threshold": {
      "type": "number",
      "label": "低额度提醒阈值（%）",
      "default": 15,
      "required": true,
      "min": 0
    }
  },
  "request": {
    "method": "GET",
    "url": "https://api.minimax.cn/v1/token_plan/remains",
    "headers": {
      "Authorization": "Bearer ${input.api_key}",
      "Accept": "application/json"
    },
    "query": {},
    "timeout_ms": 10000
  },
  "value": {
    "path": "$.model_remains[?(@.model_name=='general')].current_interval_remaining_percent",
    "type": "number",
    "multiply": 1,
    "divide": 1,
    "offset": 0,
    "decimals": 0,
    "separator": true,
    "prefix": "",
    "suffix": "%"
  },
  "alert": {
    "operator": "lt",
    "threshold": "${input.alert_threshold}",
    "title": "MiniMax · 当前周期剩余偏低",
    "message": "当前剩余 ${value}，低于设定阈值，请检查额度。"
  }
}
